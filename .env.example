# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated Supabase OAuth provider IDs enabled for this app, e.g. google,github
NEXT_PUBLIC_SUPABASE_AUTH_PROVIDERS=

# Server-only PostgreSQL URLs for Prisma. Use Supabase's pooler for runtime and
# direct connection for introspection/admin tooling. Supabase migrations own DDL.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
